{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2015",
        "lib": ["ES2015"],
        "types": [],
        "strict": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "emitDeclarationOnly": true
    },
    "include": ["src/index.ts"]
}
